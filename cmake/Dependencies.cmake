# Pinned source-only dependencies; see docs/THIRD_PARTY.md.
set(ZLIB_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
add_subdirectory(third_party/zlib EXCLUDE_FROM_ALL)
set(SDL_SHARED OFF CACHE BOOL "" FORCE)
set(SDL_STATIC ON CACHE BOOL "" FORCE)
set(SDL_TEST OFF CACHE BOOL "" FORCE)
set(SDL_TESTS OFF CACHE BOOL "" FORCE)
set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
add_subdirectory(third_party/SDL2 EXCLUDE_FROM_ALL)
set(SDL2_INCLUDE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/third_party/SDL2/include" CACHE PATH "" FORCE)
set(SDL2_LIBRARY "SDL2-static" CACHE STRING "" FORCE)
set(GBARECOMP_SELFHEAL_RECOMPILE_DEFAULT OFF CACHE BOOL "" FORCE)
set(GBARECOMP_COMPILER_CACHE OFF CACHE STRING "" FORCE)
add_subdirectory(third_party/gbarecomp)
